# Every reference/cluster PingFederate node, beside lib/pf-common.env; compose adds each node's mode, port and archive.
# Cluster traffic is authenticated (pf.cluster.auth.pwd, from the node's agent: oidf.env) and encrypted; nodes find
# each other by DNS_PING (the image's default protocol) on the alias all three share on the stack's network.
PF_RUN_pf_cluster_encrypt=true
DNS_QUERY_LOCATION=pf-cluster
# The shared Redis: OIDF_REDIS_URL (rediss://, user oidf) comes from oidf.env; this is the CA it is checked against.
OIDF_REDIS_CA_FILE=/opt/reference/tls/ca.crt
