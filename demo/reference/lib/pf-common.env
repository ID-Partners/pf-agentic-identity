# Every reference PingFederate node's environment: the production profile, with its archive age-encrypted, its data
# stores verify-full, and the components this example does not configure switched off rather than left to infer.
# Each stack's pf.env adds the node's own; compose's environment: adds the slot's ports and the issuer. KEY=VALUE only.
PING_IDENTITY_ACCEPT_EULA=YES
OIDF_DEPLOYMENT_PROFILE=production
PF_ARCHIVE_AGE_KEY_FILE=/run/oidf/age.key
# The stack's CA reaches the JVM through PingFederate's trusted CAs (the archive's), not JAVA_OPTS: PingFederate sets
# javax.net.ssl.trustStore to its own store. PgJDBC (sslrootcert) and Redis (OIDF_REDIS_CA_FILE) are given the file.
# The Shared Signals transmitter on the PostgreSQL tables (the dialect a cluster needs), with its leases there too.
OIDF_SSF_ENABLED=true
OIDF_SSF_DATA_STORE_ID=oidfruntime
OIDF_SSF_STORE_DIALECT=tables
# Production keeps a push stream's authorization header only sealed under this key (a file the secrets holder writes).
OIDF_SSF_SECRET_KEY_FILE=/run/oidf/ssf-secret-key
OIDF_LEASE_BACKEND=jdbc
OIDF_LEASE_DATA_STORE_ID=oidfruntime
# Not configured by this example: off, so production does not refuse them as unfinished.
OIDF_FEDERATION_ENABLED=false
OIDF_AUTO_REGISTRATION_ENABLED=false
OIDF_ATTESTATION_AUTH_ENABLED=false
OIDF_ATTESTATION_ISSUER_ENABLED=false
OIDF_HOSTING_ENABLED=false
OIDF_SSF_RECEIVER_ENABLED=false
OIDF_OPERATOR_API_ENABLED=false
OIDF_FAPI_ENABLED=false
