# reference/single's PingFederate: one standalone node, booting from the mounted age-encrypted archive. Without a
# shared Redis its replay caches are in memory, which production allows on one node only with the risk accepted.
OPERATIONAL_MODE=STANDALONE
OIDF_CLUSTER_MODE=STANDALONE
PF_ARCHIVE_FILE=/opt/reference/archive/data.zip.age
OIDF_ACCEPTED_RISKS=in-memory-state
