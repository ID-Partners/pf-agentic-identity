{
  "description": "SCIM vectors for the AgentInstance resource type (urn:idpartners:params:scim:schemas:core:1.0:AgentInstance), plan item X-E14. Each vector runs against a fresh instance in each register it names, in initial_status. Paths are relative to the SCIM base (/federation/scim/v2 at the attester). Placeholders: {id} the instance's agent_id, {owner} its owner.value, {device} its device id (device instances only), {register} device_instance or workload_agent, {version} the ETag its GET answers before the vector's first step. expect.body is a subset: each member given must be present and equal, an object compared member by member, an array element by element with the same length. Every error body carries the RFC 7644 error schema; expect.scimType is its scimType. Written for pf-agentic-identity's AgentInstanceScimContractTest; a copy lives in idp-scim-service docs/agent-instance-scim/.",
  "schema": "urn:idpartners:params:scim:schemas:core:1.0:AgentInstance",
  "error_schema": "urn:ietf:params:scim:api:messages:2.0:Error",
  "vectors": [
    {
      "name": "read an instance",
      "registers": [
        "device_instance",
        "workload_agent"
      ],
      "initial_status": "active",
      "steps": [
        {
          "request": {
            "method": "GET",
            "path": "/AgentInstances/{id}"
          },
          "expect": {
            "status": 200,
            "body": {
              "schemas": [
                "urn:idpartners:params:scim:schemas:core:1.0:AgentInstance"
              ],
              "id": "{id}",
              "register": "{register}",
              "status": "active",
              "active": true,
              "owner": {
                "value": "{owner}"
              },
              "meta": {
                "resourceType": "AgentInstance",
                "version": "{version}"
              }
            },
            "headers": {
              "ETag": "{version}"
            }
          }
        }
      ]
    },
    {
      "name": "read an unknown id",
      "registers": [
        "device_instance",
        "workload_agent"
      ],
      "initial_status": "active",
      "steps": [
        {
          "request": {
            "method": "GET",
            "path": "/AgentInstances/no-such-instance"
          },
          "expect": {
            "status": 404
          }
        }
      ]
    },
    {
      "name": "list by owner",
      "registers": [
        "device_instance",
        "workload_agent"
      ],
      "initial_status": "active",
      "steps": [
        {
          "request": {
            "method": "GET",
            "path": "/AgentInstances",
            "query": {
              "filter": "owner.value eq \"{owner}\""
            }
          },
          "expect": {
            "status": 200,
            "body": {
              "totalResults": 1,
              "Resources": [
                {
                  "id": "{id}",
                  "status": "active"
                }
              ]
            }
          }
        }
      ]
    },
