              "totalResults": 0,
              "Resources": []
            }
          }
        },
        {
          "request": {
            "method": "GET",
            "path": "/AgentInstances",
            "query": {
              "filter": "OWNER.VALUE eq \"{owner}\" AND status EQ \"active\""
            }
