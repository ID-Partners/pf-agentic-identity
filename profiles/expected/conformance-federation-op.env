# Rendered by tools/profile.py from profiles/conformance-federation-op.yaml - do not edit; change the profile.
# No secrets: those reach the deployment by other means.
OIDF_ATTESTATION_AUTH_ENABLED=false
OIDF_AUTO_REGISTRATION_ENABLED=true
OIDF_AUTO_REGISTRATION_REQUIRE_PKCE=false
OIDF_CIBA_SIM_DIR=/opt/ciba-sim
OIDF_CIBA_SIM_ENABLED=true
OIDF_DEPLOYMENT_PROFILE=development
OIDF_FAPI2_CLIENTS=conformance-fapi2-client1,conformance-fapi2-client2
OIDF_FAPI_ENABLED=true
OIDF_FAPI_RESOURCE_CLIENTS=conformance-ciba-client1,conformance-ciba-client2
OIDF_FEDERATION_ENABLED=true
OIDF_FEDERATION_IGNORE_SSL_ERRORS=true
OIDF_FEDERATION_ORGANIZATION_NAME=pf-agentic-identity conformance rig
OIDF_FEDERATION_SELF_ANCHOR=https://localhost:9031
OIDF_FEDERATION_TRUST_ANCHORS=https://localhost:9031
OIDF_FEDERATION_TRUST_ANCHOR_JWKS={"{{SUITE_BASE_URL}}/test/a/{{SUITE_ALIAS}}/trust-anchor": {{PUBLIC_JWKS:suite-trust-anchor}}}
OIDF_FEDERATION_TRUST_CONTROLLER_HOST=https://localhost:9031
OIDF_FETCH_HOST_ALLOWLIST=host.docker.internal
OIDF_REQUIRE_METADATA_POLICY=false
OIDF_SSF_DEFAULT_SUBJECTS=ALL
OIDF_SSF_ENABLED=true
OIDF_SSF_INTROSPECTION_CLIENT_ID=conformance-ssf-rs
OIDF_SSF_INTROSPECTION_ENDPOINT=https://localhost:9031/as/introspect.oauth2
OIDF_SSF_INTROSPECTION_INSECURE_TLS=true
OIDF_SSF_ISSUER=https://localhost:9031
OIDF_SSF_PROVISIONER_SCOPE=ssf.provision
PF_RUN_PF_HTTP_PORT=9080
PING_IDENTITY_ACCEPT_EULA=YES
